#!/bin/bash
usage() {
  echo "Usage: $0 [--help]"
  exit "${1:-0}"
}
if [ $# -ge 1 ]; then
  if [[ "$1" != "--help" ]]; then
    usage
  fi
  usage 1
fi
echo "Waiting for ssh to start..."
ret=1
fail_retry=5
deny_retry=2
while [ $ret -ne 0 ]; do
  output=$(timeout 2s rm-exec true 2>&1)
  ret=$?
  if [ $ret -eq 0 ] || [ $ret -eq 124 ]; then
    break
  fi
  if [[ "$output" == *"root@localhost: Permission denied (publickey)."* ]] ||
    [[ "$output" == *"root@localhost: Permission denied (publickey,password)."* ]] ||
    [[ "$output" == *"root@localhost: Permission denied (password)."* ]]; then
    deny_retry=$((deny_retry - 1))
    if [ $deny_retry -lt 0 ]; then
      echo "Error: Unable to connect with publickey."
      echo "  Please rm-monitor q && rm-ensure-ssh and then try again."
      echo "$output"
      exit 1
    fi
    echo "Warning $ret: Connection denied, retrying..."
    #     echo "root" | rm-serial
    #     rm-serial <<EOF
    #       mkdir -p /home/root/.ssh
    #       chmod 0700 /home/root/.ssh
    #       cp /etc/dropbear/authorized_keys /home/root/.ssh/authorized_keys
    #       chmod 0600 /home/root/.ssh/authorized_keys
    #       exit
    # EOF
    sleep 0.9
  elif [[ "$output" == *"Segmentation fault"* ]] || [ $ret -eq 139 ]; then
    echo "Error: ssh executable is broken."
    echo "$output"
    exit 1
  elif ! rm-is-running; then
    echo "Error: rm is no longer running"
    rm-is-running --verbose >/dev/null
    exit 1
  elif [ $ret -ne 255 ]; then
    fail_retry=$((fail_retry - 1))
    if [ $fail_retry -lt 0 ]; then
      echo "Error $ret: Unable to connect, likely /home/root does not exist"
      echo "  You may need to use rm-serial to login on the serial console to fix things"
      echo "$output"
      exit 1
    fi
    echo "Warning $ret: Unable to connect, retrying..."
    #     rm-serial root
    #     rm-serial <<EOF
    #       mkdir -p /home/root/.ssh
    #       chmod 0700 /home/root/.ssh
    #       cp /etc/dropbear/authorized_keys /home/root/.ssh/authorized_keys
    #       chmod 0600 /home/root/.ssh/authorized_keys
    #       exit
    # EOF
    sleep 0.9
  fi
  sleep 0.1
done
