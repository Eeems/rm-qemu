#!/bin/bash
set -e
usage() { echo "Usage: $0 [--help] [--verbose] [--quiet]"; }
verbose=false
# shellcheck disable=SC2153
if [[ "$VERBOSE" == "1" ]]; then
  verbose=true
fi
while [ $# -gt 0 ]; do
  case "$1" in
  --help)
    usage
    exit
    ;;
  --verbose)
    verbose=true
    ;;
  --quiet)
    verbose=false
    ;;
  esac
  shift
done
image="$(readlink -f "$STATEDIR/busybox-rootfs.qcow2")"
if ! lsof "$image" 2>/dev/null | grep -q qemu-system-arm; then
  echo "Busybox was not running"
  exit
fi
# shellcheck disable=SC2016
serial="${STATEDIR:-/run/rm}/busybox-serial"
if [ ! -S "$serial" ]; then
  echo "Error: busybox serial socket not found"
  exit 1
fi
if $verbose; then
  socat STDIO,ignoreeof UNIX-CONNECT:"$serial" 2>&1 &
fi
serial-client "$serial" exit
echo "Waiting for busybox to stop..."
if [ -S "$serial" ]; then
  socat STDIO,ignoreeof UNIX-CONNECT:"$serial" >/dev/null 2>&1
fi
while lsof "$image" 2>/dev/null | grep -q qemu-system-arm; do
  sleep 0.1
done
rm -f "$STATEDIR/busybox-rootfs.qcow2"
