#!/bin/bash
set -e
usage() { echo "Usage: $0 [--help] [--verbose] [--quiet]"; }
verbose=false
# shellcheck disable=SC2153
if [[ "$VERBOSE" == "1" ]]; then
  verbose=true
fi
while [ $# -gt 0 ]; do
  case "$1" in
  --help)
    usage
    exit
    ;;
  --verbose)
    verbose=true
    ;;
  --quiet)
    verbose=false
    ;;
  esac
  shift
done
image="$(readlink -f "$STATEDIR/busybox-rootfs.qcow2")"
if ! lsof "$image" 2>/dev/null | grep -q qemu-system-arm; then
  echo "Busybox was not running"
  exit
fi
serial="${STATEDIR:-/run/rm}/busybox-serial"
if [ ! -S "$serial" ]; then
  echo "Error: busybox serial socket not found"
  exit 1
fi
if $verbose; then
  if [ -f "$serial.log" ]; then
    tail -f "$serial.log" &
    # shellcheck disable=SC2064
    trap "kill -TERM $!" EXIT
  else
    echo "Unable to find busybox-serial.log"
  fi
fi
rm-busybox-umount
# shellcheck disable=SC2016
rm-busybox-exec sh -c 'kill -9 "$(pgrep -P 1 sh)" || true' || true
serial-client "$serial" exit || true
echo "Waiting for busybox to stop..."
while lsof "$image" 2>/dev/null | grep -q qemu-system-arm; do
  sleep 0.1
done
rm -f "$STATEDIR/busybox-rootfs.qcow2" "$STATEDIR/busybox-serial.log"
if $verbose; then
  set +e
  code="$(trap -p EXIT)"
  trap - EXIT
  eval "${code:9:-6}"
fi
