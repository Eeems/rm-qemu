#!/bin/bash
set -e
APPDIR="rm-qemu.AppDir"
rm -rf "${APPDIR}"

# Copy initial files
mkdir -p \
  "${APPDIR}/bin" \
  "$APPDIR/share/rm-qemu/artifact"
cp \
  appimage-entrypoint \
  "${APPDIR}/bin"

# Import some helper programs that can be run with sharun
APPDIR="${APPDIR}" \
  PATH="/usr/local/bin:${PATH}" \
  DESKTOP="rm-qemu.desktop" \
  ICON=rm-qemu.png \
  MAIN_BIN=appimage-entrypoint \
  STRACE_MODE=0 \
  _tmp_bin=rm-qemu-bin \
  _tmp_lib=rm-qemu-lib \
  _tmp_share=rm-qemu-share \
  quick-sharun \
  /usr/bin/{rm2fb-emu,socat} \
  /usr/bin/qemu-{img,system-arm,pr-helper,storage-daemon} \
  /usr/libexec/qemu-bridge-helper \
  /usr/share/qemu/

# ponytail: stub the external hook that upstream repo removed (fix-gnome-csd.hook 404)
echo '# stub hook - upstream file removed' > "${APPDIR}/bin/fix-gnome-csd.hook"
chmod +x "${APPDIR}/bin/fix-gnome-csd.hook"
# ponytail: end stub
_hook="${APPDIR}/bin/path-mapping-hardcoded.src.hook"
if [ -f "$_hook" ]; then
  sed -i -e 's|_tmp_bin=""|_tmp_bin="rm-qemu-bin"|' "$_hook"
  sed -i -e 's|_tmp_lib=""|_tmp_lib="rm-qemu-lib"|' "$_hook"
  sed -i -e 's|_tmp_share=""|_tmp_share="rm-qemu-share"|' "$_hook"
else
  cat <<-'EOF' >"$_hook"
  #!/bin/sh
  _tmp_bin="rm-qemu-bin"
  _tmp_lib="rm-qemu-lib"
  _tmp_share="rm-qemu-share"

  if ! command -v ln 1>/dev/null; then
      >&2 echo "path-mapping-hardcoded: ERROR we cannot make symlinks"
      >&2 echo "because command 'ln' is missing from the system! Aborting..."
      exit 1
  fi

  if [ -n "$_tmp_bin" ]; then
      ln -sfn "$APPDIR"/bin /tmp/"$_tmp_bin"
  fi
  if [ -n "$_tmp_lib" ]; then
      ln -sfn "$APPDIR"/lib /tmp/"$_tmp_lib"
  fi
  if [ -n "$_tmp_share" ]; then
      ln -sfn "$APPDIR"/share /tmp/"$_tmp_share"
  fi
EOF
  chmod +x "$_hook"
fi

# Copy static files
cp -a /artifact/. "$APPDIR/share/rm-qemu/artifact/"
cp -a \
  /usr/local/bin/. \
  "${APPDIR}/bin"
# ponytail: inject rebuilt binary (quick-sharun puts it at shared/bin/, launcher at bin/ is old)
cp -a /usr/bin/qemu-system-arm "${APPDIR}/bin/qemu-system-arm"
chmod +x "${APPDIR}/bin/qemu-system-arm"
# ponytail: fix shrink-image AFTER all cp -a (both bin/ and shared/bin/ exist)
sed -i 's/compression_type=zstd/compression_type=zlib/g' "${APPDIR}/bin/shrink-image" 2>/dev/null || true
sed -i 's/compression_type=zstd/compression_type=zlib/g' "${APPDIR}/shared/bin/shrink-image" 2>/dev/null || true
sed -i 's/ -c / /g' "${APPDIR}/bin/shrink-image" 2>/dev/null || true
sed -i 's/ -c / /g' "${APPDIR}/shared/bin/shrink-image" 2>/dev/null || true
# ponytail: end

APPDIR="${APPDIR}" \
  OUTNAME=rm-qemu.AppImage \
  VERSION="$(date +%Y.%m.%d-%H%M)" \
  uruntime2appimage
