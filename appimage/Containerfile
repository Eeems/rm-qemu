FROM ghcr.io/eeems/rm-qemu:latest

RUN bash -e <<EOT
  export DEBIAN_FRONTEND="noninteractive"
  apt-get update
  apt-get dist-upgrade -y --no-install-recommends
  apt-get install -y --no-install-recommends \
    gcc \
    xvfb \
    libc6-dev \
    coreutils \
    wget \
    zsync \
    git \
    make \
    xauth \
    ca-certificates \
    patchelf
  apt-get clean
  rm -rf /var/lib/apt/lists/*
EOT

RUN <<EOT
  set -e
  wget \
    --retry-connrefused \
    --tries=30 \
    "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/refs/heads/main/useful-tools/quick-sharun.sh" \
    --output-document=/usr/bin/quick-sharun
  chmod +x /usr/bin/quick-sharun
  wget \
    --retry-connrefused \
    --tries=30 \
    "https://raw.githubusercontent.com/pkgforge-dev/Anylinux-AppImages/refs/heads/main/useful-tools/uruntime2appimage.sh" \
    --output-document=/usr/bin/uruntime2appimage
  chmod +x /usr/bin/uruntime2appimage
EOT

# removed ln-wrapper
COPY entrypoint /usr/bin
COPY bin/. /usr/local/bin/

# ponytail: sharun runs in the AppDir where BusyBox ln lacks -r. Install GNU ln from coreutils
# as /usr/bin/gnuln and a shim that delegates -r to gnuln, otherwise to BusyBox ln.
COPY bin/ln /usr/local/bin/ln
RUN set -e; \
  cp /usr/bin/ln /usr/bin/gnuln; \
  chmod +x /usr/local/bin/ln

ENTRYPOINT [ "/usr/bin/entrypoint" ]
